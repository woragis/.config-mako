# Tokyo Night Storm — mako
# Same glass as the AGS bar: quiet border, scarce accent, Hyprland blur.

font=JetBrainsMono Nerd Font 12
anchor=top-right
layer=overlay
# Bar layer is 52px; 16px side gap matches bar-shell margin
outer-margin=60,16,16,16
margin=8
padding=12,14
width=340
height=160
border-size=1
border-radius=14
icons=1
max-icon-size=36
icon-location=left
icon-border-radius=10
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus
markup=1
actions=1
default-timeout=4500
ignore-timeout=0
max-visible=3
max-history=20
sort=-time
group-by=app-name
format=<span weight="600">%s</span>\n<span fgcolor="#a9b1d6">%b</span>
text-alignment=left

# ~72% #1a1b26 — blur does the rest (hypr layer_rule notifications)
background-color=#1a1b26b8
text-color=#c0caf5ff
border-color=#c0caf517
progress-color=over #7aa2f744

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all
on-touch=dismiss

[urgency=low]
border-color=#c0caf512
text-color=#a9b1d6ff
default-timeout=3000

[urgency=normal]
border-color=#c0caf517
default-timeout=4500

[urgency=critical]
border-color=#f7768e4d
background-color=#1a1b26d9
text-color=#c0caf5ff
default-timeout=0
ignore-timeout=1

[grouped]
format=<span size="x-small" fgcolor="#565f89">%a  ·  %g</span>\n<span weight="600">%s</span>\n<span fgcolor="#a9b1d6">%b</span>

[hidden]
format=<span fgcolor="#565f89">+%h more</span>

[app-name=Subliminals]
border-color=#bb9af755
default-timeout=3500

[app-name=Music]
border-color=#9ece6a55
default-timeout=4000

[app-name=strawberry]
border-color=#9ece6a55
default-timeout=4000
