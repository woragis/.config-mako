# Tokyo Night Storm — mako notifications
# Docs: man 5 mako

font=JetBrainsMono Nerd Font 11
anchor=top-right
layer=overlay
# Clear the AGS bar (~30px) + gap
outer-margin=42,12,12,12
margin=8
padding=10,14
width=360
height=140
border-size=2
border-radius=12
icons=1
max-icon-size=48
icon-border-radius=8
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus
markup=1
actions=1
default-timeout=5000
ignore-timeout=0
max-visible=4
max-history=20
sort=-time
group-by=app-name
format=<b>%s</b>\n%b
text-alignment=left

background-color=#1a1b26ee
text-color=#c0caf5ff
border-color=#7aa2f7cc
progress-color=over #7aa2f7ff

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all
on-touch=dismiss

[urgency=low]
border-color=#565f89aa
text-color=#a9b1d6ff
default-timeout=3500

[urgency=normal]
border-color=#7aa2f7cc
default-timeout=5000

[urgency=critical]
border-color=#f7768eff
border-size=3
background-color=#1a1b26ff
text-color=#c0caf5ff
default-timeout=0
ignore-timeout=1

[app-name=Music]
border-color=#9ece6acc
default-timeout=4000

[app-name=strawberry]
border-color=#9ece6acc
